# ==============================================================================
# AGAMOS Environment Configuration & Free Mailing Setup
# ==============================================================================

# Core Django Settings
DEBUG=True
SECRET_KEY=agamos-bespoke-luxury-secret-key-2026-production-ready
ALLOWED_HOSTS=127.0.0.1,localhost,.vercel.app,.onrender.com

# Frontend Public URL (Used for email tracking and confirmation links)
FRONTEND_URL=https://agamos.vercel.app

# ==============================================================================
# Payment Bypass / Skip-Payment Configuration
# ==============================================================================
# Set to 'True' to skip the Paystack gateway and confirm orders/bookings directly.
SKIP_PAYMENT=True

# Paystack API Keys (Used when SKIP_PAYMENT=False)
PAYSTACK_SECRET_KEY=sk_test_agamos_dummy_secret_key
PAYSTACK_PUBLIC_KEY=pk_test_agamos_dummy_public_key
PAYSTACK_BASE_URL=https://api.paystack.co

# ==============================================================================
# Free Mailing System Setup (Gmail SMTP or Brevo)
# ==============================================================================
# ------------------------------------------------------------------------------
# Option A: FREE GMAIL SMTP (Recommended - 500 emails/day, 100% Free)
# 1. Enable 2-Step Verification on your Google Account (myaccount.google.com/security)
# 2. Go to "App Passwords" (myaccount.google.com/apppasswords)
# 3. Create a new App Password named "AGAMOS" (generates a 16-character code)
# 4. Fill in below:
# ------------------------------------------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=AGAMOS Luxury Concierge <your-email@gmail.com>

# ------------------------------------------------------------------------------
# Option B: BREVO / SENDINBLUE FREE SMTP (300 emails/day forever free)
# EMAIL_HOST=smtp-relay.brevo.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-brevo-login-email@example.com
# EMAIL_HOST_PASSWORD=your-brevo-smtp-key
# DEFAULT_FROM_EMAIL=AGAMOS Luxury Concierge <concierge@yourdomain.com>
# ------------------------------------------------------------------------------

# Note: If EMAIL_HOST_USER and EMAIL_HOST_PASSWORD are not set, the platform
# automatically defaults to console.EmailBackend so development never fails.
